{
  "Logging": { "LogLevel": { "Default": "Information" } },
  "Database": {
    "Provider": "SqlServer",
    "VisibleTables": "EMPLOYEES,DEPARTMENTS,JOBS,LOCATIONS,EMPLOYEES_ENRICHED,DEPARTMENTS_ENRICHED"
  },
  // SECURITY NOTE: the Oracle "hr" user is schema-scoped to the HR tables only.
  // ConnectionStrings:HrData below uses LocalDB's default developer identity via
  // Trusted_Connection, which is fine for this throwaway dev database (HrData on
  // (localdb)\mssqllocaldb) but must NOT be reused as-is against any non-throwaway
  // SQL Server instance — create a login scoped to SELECT-only on
  // EMPLOYEES/DEPARTMENTS/JOBS/LOCATIONS first, matching the Oracle user's security posture.
  "ConnectionStrings": {
    "HrData": "Server=(localdb)\\mssqllocaldb;Database=HrData;Trusted_Connection=True;"
  },
  "Urls": "http://localhost:5200"
}
