@using System.Globalization
@using System.Text.Json
@inject ChatSessionService Session
@implements IDisposable

@if (Session.ConfirmedChartDataSet is null || Session.ConfirmedChart is null)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:200px;color:var(--mud-palette-text-secondary)">
        <MudIcon Icon="@Icons.Material.Filled.BarChart" Style="font-size:48px" />
        <MudText Typo="Typo.body2" Class="mt-2">Confirm a chart from the chat to see it here</MudText>
    </div>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudText Typo="Typo.subtitle2">@Session.ConfirmedChartDataSet.Title</MudText>
        <MudSelect T="ChartType" @bind-Value="_chartType" Dense="true"
                   Variant="Variant.Outlined" Style="width:130px">
            <MudSelectItem Value="ChartType.Bar">Bar</MudSelectItem>
            <MudSelectItem Value="ChartType.Donut">Donut</MudSelectItem>
            <MudSelectItem Value="ChartType.Line">Line</MudSelectItem>
        </MudSelect>
    </MudStack>

    <MudText Typo="Typo.caption" Class="mb-2">
        X-axis: @Session.ConfirmedChart.XAxisColumn | Y-axis: @Session.ConfirmedChart.YAxisColumn
    </MudText>

    <MudChart ChartType="_chartType"
              ChartSeries="@_chartSeries"
              XAxisLabels="@_chartLabels"
              InputData="@_inputData"
              InputLabels="@_chartLabels"
              Width="100%"
              Height="@(FullScreen ? "480px" : "220px")"
              Class="mb-4" />
}

@code {
    [Parameter] public bool FullScreen { get; set; }

    private ChartType _chartType = ChartType.Bar;
    private List<ChartSeries> _chartSeries = [];
    private string[] _chartLabels = [];
    private double[] _inputData = [];

    protected override void OnInitialized()
    {
        BuildChart();
        Session.OnChange += OnSessionChange;
    }

    private void OnSessionChange()
    {
        BuildChart();
        InvokeAsync(StateHasChanged);
    }

    private void BuildChart()
    {
        var dataSet = Session.ConfirmedChartDataSet;
        var chart = Session.ConfirmedChart;
        if (dataSet is null || chart is null)
        {
            _chartSeries = [];
            _chartLabels = [];
            _inputData = [];
            return;
        }

        var points = dataSet.Rows
            .Select(row =>
            {
                var label = row.TryGetValue(chart.XAxisColumn, out var labelValue)
                    ? FormatLabel(labelValue)
                    : "";
                var value = row.TryGetValue(chart.YAxisColumn, out var numericValue)
                    && TryGetNumber(numericValue, out var number)
                    ? number
                    : 0.0;
                return (label, value);
            })
            .ToArray();

        _chartLabels = points.Select(point => point.label.Length <= 18
                ? point.label
                : point.label[..18] + "...")
            .ToArray();
        _inputData = points.Select(point => point.value).ToArray();
        _chartSeries =
        [
            new ChartSeries
            {
                Name = chart.YAxisColumn,
                Data = _inputData
            }
        ];
    }

    private static string FormatLabel(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.String => value.GetString() ?? "",
        JsonValueKind.Null or JsonValueKind.Undefined => "",
        _ => value.ToString()
    };

    private static bool TryGetNumber(JsonElement value, out double number)
    {
        if (value.ValueKind == JsonValueKind.Number && value.TryGetDouble(out number))
            return true;
        number = 0.0;
        return value.ValueKind == JsonValueKind.String
            && double.TryParse(value.GetString(), NumberStyles.Float, CultureInfo.InvariantCulture, out number);
    }

    public void Dispose() => Session.OnChange -= OnSessionChange;
}
