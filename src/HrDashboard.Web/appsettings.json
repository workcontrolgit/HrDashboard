{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AI": {
    "Provider": "Ollama",
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": "llama3.1"
    },
    "AzureOpenAI": {
      "Endpoint": "",
      "DeploymentName": "gpt-5-mini"
    }
  },
  "McpServer": {
    "Endpoint": "http://localhost:5200/mcp"
  }
}
