@using Microsoft.JSInterop
@inject ChatSessionService Session
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@implements IDisposable

<div class="hr-prompt-bar">
    @if (Session.Messages.Count == 0 && Session.SchemaOverview is { Count: > 0 })
    {
        <MudPaper Class="pa-3 mb-3" Outlined="true">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Data available to explore</MudText>
            <MudExpansionPanels Elevation="0">
                @foreach (var table in Session.SchemaOverview)
                {
                    <MudExpansionPanel Text="@table.TableName">
                        <MudText Typo="Typo.body2">@string.Join(", ", table.Columns)</MudText>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </MudPaper>
    }
    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
        <MudTextField @bind-Value="_prompt"
                      InputId="prompt-textbox"
                      Placeholder="Ask an HR analytics question..."
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Lines="2"
                      Immediate="true"
                      Disabled="Session.IsStreaming"
                      OnKeyDown="HandleKeyDown" />
        <MudIconButton Icon="@Icons.Material.Filled.Send"
                       Color="Color.Primary"
                       Size="Size.Large"
                       OnClick="SendAsync"
                       Disabled="Session.IsStreaming || string.IsNullOrWhiteSpace(_prompt)"
                       title="Send (Enter) — Shift+Enter for new line" />
    </MudStack>

    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mt-2" Spacing="1">
        @foreach (var preset in _presets)
        {
            <MudChip T="string" OnClick="() => SelectPresetAsync(preset)"
                     Color="Color.Default" Size="Size.Small"
                     Disabled="Session.IsStreaming">@preset</MudChip>
        }
    </MudStack>
</div>

@code {
    private string _prompt = string.Empty;
    private string? _userId;

    private readonly string[] _presets =
    [
        "Average salary by department",
        "Top 10 highest-paid employees",
        "Headcount per department",
        "Job salary ranges",
        "Departments with more than 5 employees"
    ];

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += StateHasChanged;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await Session.EnsureSchemaOverviewLoadedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            await JS.InvokeVoidAsync("hrDashboard.preventEnterSubmit", "prompt-textbox");
        }
        catch (JSException)
        {
        }
    }

    private async Task SelectPresetAsync(string preset)
    {
        if (Session.IsStreaming || _userId is null) return;
        await Session.SendAsync(preset, _userId);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Shift+Enter inserts a newline (default textarea behavior); plain Enter submits.
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendAsync();
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_prompt) || Session.IsStreaming || _userId is null) return;
        var prompt = _prompt.Trim();
        _prompt = string.Empty;
        await Session.SendAsync(prompt, _userId);
    }

    public void Dispose() => Session.OnChange -= StateHasChanged;
}
