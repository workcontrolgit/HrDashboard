@inject ChatSessionService Session
@implements IDisposable

@if (Session.CurrentMetrics.Count == 0)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:200px;color:var(--mud-palette-text-secondary)">
        <MudIcon Icon="@Icons.Material.Filled.BarChart" Style="font-size:48px" />
        <MudText Typo="Typo.body2" Class="mt-2">Results appear here</MudText>
    </div>
}
else
{
    @if (_chartable)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.subtitle2">Visualization</MudText>
            <MudSelect T="ChartType" @bind-Value="_chartType" Dense="true"
                       Variant="Variant.Outlined" Style="width:130px">
                <MudSelectItem Value="ChartType.Bar">Bar</MudSelectItem>
                <MudSelectItem Value="ChartType.Donut">Donut</MudSelectItem>
                <MudSelectItem Value="ChartType.Line">Line</MudSelectItem>
            </MudSelect>
        </MudStack>

        <MudChart ChartType="_chartType"
                  ChartSeries="@_chartSeries"
                  XAxisLabels="@_chartLabels"
                  InputData="@_inputData"
                  InputLabels="@_chartLabels"
                  Width="100%"
                  Height="@(FullScreen ? "480px" : "220px")"
                  Class="mb-4" />
    }

    <MudText Typo="Typo.subtitle2" Class="mb-2">
        Data (@Session.CurrentMetrics.Count rows)
    </MudText>
    <MudDataGrid T="HrMetricRow"
                 Items="Session.CurrentMetrics"
                 Dense="true"
                 Striped="true"
                 Hover="true"
                 Filterable="false"
                 SortMode="SortMode.Single">
        <Columns>
            <PropertyColumn Property="r => r.Label"    Title="Label"    Sortable="true" />
            <PropertyColumn Property="r => r.Value"    Title="Value"    Sortable="true" Format="N2" />
            <PropertyColumn Property="r => r.Category" Title="Category" Sortable="true" />
        </Columns>
    </MudDataGrid>
}

@code {
    /// <summary>When true (shown inside the full-screen results dialog), the chart renders taller.</summary>
    [Parameter] public bool FullScreen { get; set; }

    private ChartType _chartType = ChartType.Bar;
    private List<ChartSeries> _chartSeries = [];
    private string[] _chartLabels = [];
    private double[] _inputData = [];
    private bool _chartable = true;

    protected override void OnInitialized()
    {
        // Sync to whatever metrics already exist (e.g. this instance was just created
        // inside the full-screen results dialog, after the sidebar's ResultsPanel already
        // has data) — subscribing alone only catches *future* changes, not current state.
        BuildChart();
        Session.OnChange += OnSessionChange;
    }

    private void OnSessionChange()
    {
        BuildChart();
        InvokeAsync(StateHasChanged);
    }

    private void BuildChart()
    {
        // A single response is one homogeneous result set — if the model marked any row
        // non-chartable (e.g. a plain listing like "list employees"), treat the whole
        // result as table-only rather than drawing a chart from a mix of shapes.
        _chartable = Session.CurrentMetrics.Count > 0 && Session.CurrentMetrics.All(r => r.Chartable);

        if (!_chartable)
        {
            _chartSeries = [];
            _chartLabels = [];
            _inputData = [];
            return;
        }

        _chartLabels = Session.CurrentMetrics
            .Select(r => r.Label.Length <= 18 ? r.Label : r.Label[..18] + "…")
            .ToArray();

        // Bar/Line/StackedBar read ChartSeries + XAxisLabels; Donut/Pie instead read
        // InputData + InputLabels — MudChart does not share one data model across chart types.
        _inputData = Session.CurrentMetrics.Select(r => r.Value).ToArray();

        _chartSeries =
        [
            new ChartSeries
            {
                Name = "Value",
                Data = _inputData
            }
        ];
    }

    public void Dispose() => Session.OnChange -= OnSessionChange;
}
